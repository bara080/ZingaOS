# Supabase Auth — Zinga admin dashboard
# Copy to .env.local and fill in real values (never commit real secrets).

# Public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server-only. Bypasses RLS. NEVER expose to the client or commit real value.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Base URL of this admin app — used to build invite redirect links
# (Supabase inviteUserByEmail redirectTo -> /invite/accept). Optional in dev.
NEXT_PUBLIC_APP_URL=http://localhost:3000
