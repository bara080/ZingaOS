# Supabase Auth — Zinga admin dashboard
# Copy to .env.local and fill in real values (never commit real secrets).

# Public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server-only. Bypasses RLS. NEVER expose to the client or commit real value.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Base URL of this admin app — used to build invite redirect links
# (Supabase inviteUserByEmail redirectTo -> /invite/accept). Optional in dev.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Operator console (/console/operator.html + /api/operator/*) ──────────────
# ALL server-only. Never expose to the browser. In production add these to the
# Vercel `zinga-os-web` project (Production env).

# Apify — lead scraping (Scrape tab). Used by /api/operator/scrape/*.
APIFY_TOKEN=apify_api_xxx

# SMTP — cold email batch send (Email tab). Used by /api/operator/send-batch.
# OUTREACH_FROM MUST be a @zingaapp.com address (never a personal inbox).
# CAN_SPAM_ADDRESS is the physical mailing address required in the footer.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=info@zingaapp.com
SMTP_PASSWORD=xxx
OUTREACH_FROM=info@zingaapp.com
CAN_SPAM_ADDRESS=Zinga, 123 Main St, New York, NY 10001

# Meta Graph API — Instagram DM (IG DM channel). Used by /api/operator/ig/*.
META_ACCESS_TOKEN=xxx
META_IG_USER_ID=1784xxxxxxxxxxxxx
META_GRAPH_VERSION=v21.0
