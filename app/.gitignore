# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but keep the example (key names only, no secrets) committable
# .env.local.example is intentionally NOT committed (gitignored) — it kept
# tripping the guard_git hook on placeholder credential-shaped lines.

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
package-lock.json

# claude
CLAUDE.md
implementation.md
# anchor to the app root so it ignores app/docs/ only — NOT src/components/docs/
# (those components are imported by the api-doc pages and must be in git for builds).
/docs/

# brainstorm sessions
.superpowers/
.env*.local
